<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/vs_10">

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="@dimen/vs_120"
        android:layout_height="wrap_content"
        android:textColor="@color/color_CC000000"
        android:textSize="@dimen/ts_22" />

    <EditText
        android:id="@+id/etInput"
        android:layout_width="0dp"
        android:layout_height="@dimen/vs_45"
        android:layout_weight="1"
        android:background="@drawable/input_dialog_api_input"
        android:inputType="text"
        android:maxLines="1"
        android:paddingLeft="@dimen/vs_5"
        android:paddingTop="@dimen/vs_5"
        android:paddingRight="@dimen/vs_5"
        android:paddingBottom="@dimen/vs_5"
        android:textColor="@color/color_CC000000"
        android:textColorHint="@color/color_6C3D3D3D"
        android:textSize="@dimen/ts_22" />

</LinearLayout>
