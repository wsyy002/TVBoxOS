<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/vs_300"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/vs_5"
    android:background="@drawable/shape_user_focus"
    android:focusable="true"
    android:padding="@dimen/vs_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_thumb_bottom_name"
        android:orientation="vertical"
        android:padding="@dimen/vs_15">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_60"
            android:layout_gravity="center_horizontal"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_folder" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/color_999999"
            android:textSize="@dimen/ts_18"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/delFrameLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/shape_user_delete"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_60"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/vs_10"
            android:src="@drawable/icon_delete" />
    </FrameLayout>

</FrameLayout>
